{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "xcodebuild -project TimeSquirrel.xcodeproj -scheme TimeSquirrel -configuration Debug -derivedDataPath .build build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$xcodebuild"
        }
    ]
}
